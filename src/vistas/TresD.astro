---
// src/vistas/TresD.astro
// La galería 3D (en español en /3d y en inglés en /en/3d) y, debajo, los breakdowns de los materiales
import Layout from '../layouts/layout.astro';
import Navbar from '../components/Navbar.astro';
import Contacto from '../components/Contacto.astro';
import PixelCard from '../components/PixelCard.astro';
import Carrusel from '../components/Carrusel.astro';
import Lightbox from '../components/Lightbox.astro';
import Breakdown from '../components/Breakdown.astro';
import { arcane, comic, crystal } from '../data/materiales';
import { obras, colecciones } from '../data/tresD';
import { idiomaDe, rutas } from '../i18n/idioma';
import { textos } from '../i18n/textos';
import { traducir } from '../i18n/obras';

const idioma = idiomaDe(Astro);
const t = textos(idioma).tresD;
const g = textos(idioma).galeria;
---

<Layout>
    <Navbar />
    
    <!-- Cabecera de Diseño 3D -->
    <section class="pt-40 pb-12 px-5 text-center relative z-10">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-4">
            <span class="bg-gradient-to-r from-[#00ff66] via-[#00ccff] to-[#00ff66] bg-[length:200%_auto] text-transparent bg-clip-text animate-[gradientFlow_6s_infinite_linear]">
                {t.titulo}
            </span>
        </h1>
        <p class="text-[#cbd5e1] text-lg max-w-2xl mx-auto">
            {t.texto}
        </p>
        <a href="#breakdowns" class="inline-block mt-6 text-[#00ff66] font-bold hover:underline">{t.verBreakdowns}</a>
    </section>

    <!-- Galería 3D -->
    <section class="pb-10 px-5 relative z-10">
        <!-- Contenedor unificado para botones y galería -->
        <div class="w-full max-w-[4000px] mx-auto">
            
            <!-- Botones de Filtro (Temática Verde 3D) -->
            <div id="filtros" class="flex flex-wrap justify-center gap-3 mb-12" data-activo="bg-[#00ff66] text-[#0a0508] shadow-[0_0_15px_rgba(0,255,102,0.3)]">
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#00ff66] text-[#0a0508] shadow-[0_0_15px_rgba(0,255,102,0.3)]" data-filter="Colecciones">{g.colecciones}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="All">{g.todos}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Modelado">{g.modelado}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Personaje">{g.personajes}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Animación">{g.animacion}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Materiales">{g.materiales}</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Procedural">Procedural</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="VFX">VFX</button>
            </div>

        </div>

        <!-- Vista "Colecciones" (por defecto): un carrusel por colección (src/data/tresD.ts) -->
        <div id="colecciones" class="space-y-12">
            {colecciones.map((coleccion, i) => (
                <Carrusel titulo={traducir(coleccion.titulo, idioma)} obras={obras.filter(coleccion.incluye)} inverso={i % 2 === 1} />
            ))}
        </div>

        <!-- Vista "Todos" (y el resto de filtros): todas las obras en columnas. El contenedor es elástico hasta
             los 4000px y columns-[300px] crea automáticamente las columnas que quepan según el ancho/zoom -->
        <div id="galeria-todos" class="hidden w-full max-w-[4000px] mx-auto" data-galeria>
            <div class="columns-1 sm:columns-[250px] md:columns-[300px] gap-6 space-y-6">
                {obras.map((obra) => <PixelCard {...obra} />)}
            </div>
        </div>
    </section>

    <!-- Breakdowns de materiales (src/data/materiales.ts); el post-procesado de Neorb está en su ficha -->
    <section id="breakdowns" class="pb-16 px-5 relative z-10">
        <div class="container mx-auto max-w-6xl">
            <h2 class="text-3xl md:text-5xl font-bold mb-4 text-center">
                <span class="bg-gradient-to-r from-[#00ff66] to-[#00ccff] text-transparent bg-clip-text">{t.breakdowns}</span>
            </h2>
            <p class="text-[#cbd5e1] text-center max-w-2xl mx-auto">{t.breakdownsTexto}</p>
            <p class="text-center mt-2"><a href={`${rutas(idioma).proyecto('neorb')}#breakdown-post-proceso`} class="text-[#00ff66] hover:underline">{t.postProceso}</a></p>
            <div class="breakdowns">
                {[comic, arcane, crystal].map((breakdown) => <Breakdown breakdown={breakdown} />)}
            </div>
        </div>
    </section>

    <Contacto />

    <Lightbox acento="#00ff66" acentoSuave="rgba(0,255,102,0.15)" />
</Layout>
