    <Contacto />

    <!-- ========================================= -->
    <!-- MODAL / LIGHTBOX (Soporte Imagen y Vídeo) -->
    <!-- ========================================= -->
    <div id="lightbox" class="fixed inset-0 z-[100] hidden bg-[#0a0508]/75 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        
        <!-- Controles de Zoom -->
        <div class="absolute top-6 left-6 md:top-10 md:left-10 flex gap-2 z-50 bg-[#0a0508]/80 p-1.5 rounded-xl border border-white/10 backdrop-blur-md">
            <button id="zoom-out" class="text-white hover:text-[#00ff66] w-8 h-8 flex items-center justify-center text-2xl font-bold transition-colors cursor-pointer select-none rounded hover:bg-white/10">-</button>
            <button id="zoom-reset" class="text-white/80 hover:text-white w-10 flex items-center justify-center text-sm font-medium transition-colors cursor-pointer select-none rounded hover:bg-white/10">1x</button>
            <button id="zoom-in" class="text-white hover:text-[#00ff66] w-8 h-8 flex items-center justify-center text-2xl font-bold transition-colors cursor-pointer select-none rounded hover:bg-white/10">+</button>
        </div>

        <button id="lightbox-close" class="absolute top-6 right-6 md:top-10 md:right-10 text-white/50 hover:text-[#00ff66] text-5xl font-light z-50 transition-colors cursor-pointer">&times;</button>
        
        <button id="lightbox-prev" class="absolute left-2 md:left-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-[#00ff66] z-50 transition-colors cursor-pointer select-none p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        <!-- Contenedores maximizados (Uno para IMG y otro para VIDEO) -->
        <img id="lightbox-img" src="" alt="Arte maximizado" class="hidden max-w-full max-h-[90vh] object-contain drop-shadow-[0_0_50px_rgba(0,255,102,0.15)] scale-95 transition-transform duration-150 z-40 will-change-transform" />
        
        <video id="lightbox-video" src="" autoplay loop muted playsinline class="hidden max-w-full max-h-[90vh] object-contain drop-shadow-[0_0_50px_rgba(0,255,102,0.15)] scale-95 transition-transform duration-150 z-40 will-change-transform"></video>

        <button id="lightbox-next" class="absolute right-2 md:right-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-[#00ff66] z-50 transition-colors cursor-pointer select-none p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

    </div>
</Layout>

<!-- ========================================= -->
<!-- LÓGICA JAVASCRIPT PARA EL LIGHTBOX        -->
<!-- ========================================= -->
<script>
    const triggers = Array.from(document.querySelectorAll('.lightbox-trigger'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    
    const zoomInBtn = document.getElementById('zoom-in');
    const zoomOutBtn = document.getElementById('zoom-out');
    const zoomResetBtn = document.getElementById('zoom-reset');

    let currentIndex = 0;
    let currentZoom = 1;

    if (lightbox && lightboxImg && lightboxVideo) {
        
        const applyZoom = () => {
            lightboxImg.style.transform = `scale(${currentZoom})`;
            lightboxVideo.style.transform = `scale(${currentZoom})`;
            if (zoomResetBtn) zoomResetBtn.innerText = `${Math.round(currentZoom * 10) / 10}x`;
        };

        const resetZoom = () => {
            currentZoom = 1;
            lightboxImg.style.transform = ''; 
            lightboxVideo.style.transform = ''; 
            if (zoomResetBtn) zoomResetBtn.innerText = '1x';
            lightboxImg.classList.add('scale-100'); 
            lightboxVideo.classList.add('scale-100'); 
        };

        lightbox.addEventListener('wheel', (e) => {
            if (!lightbox.classList.contains('hidden')) {
                e.preventDefault(); 
                if (e.deltaY < 0) {
                    currentZoom = Math.min(currentZoom + 0.25, 4); 
                } else {
                    currentZoom = Math.max(currentZoom - 0.25, 0.5); 
                }
                applyZoom();
            }
        });

        zoomInBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            currentZoom = Math.min(currentZoom + 0.5, 4);
            applyZoom();
        });
        
        zoomOutBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            currentZoom = Math.max(currentZoom - 0.5, 0.5);
            applyZoom();
        });

        zoomResetBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            resetZoom();
        });

        const showMedia = (index) => {
            const src = triggers[index].getAttribute('data-src');
            if (src) {
                resetZoom(); 
                
                const isVideo = src.endsWith('.webm') || src.endsWith('.mp4');
                
                if (isVideo) {
                    lightboxImg.classList.add('hidden');
                    lightboxImg.src = '';
                    
                    lightboxVideo.src = src;
                    lightboxVideo.classList.remove('hidden');
                    lightboxVideo.play();
                } else {
                    lightboxVideo.classList.add('hidden');
                    lightboxVideo.pause();
                    lightboxVideo.src = '';
                    
                    lightboxImg.src = src;
                    lightboxImg.classList.remove('hidden');
                }
            }
        };

        triggers.forEach((trigger, index) => {
            trigger.addEventListener('click', () => {
                currentIndex = index;
                showMedia(currentIndex);
                
                lightbox.classList.remove('hidden');
                setTimeout(() => {
                    lightbox.classList.remove('opacity-0');
                    lightboxImg.classList.remove('scale-95');
                    lightboxVideo.classList.remove('scale-95');
                    lightboxImg.classList.add('scale-100');
                    lightboxVideo.classList.add('scale-100');
                }, 10);
                
                document.body.style.overflow = 'hidden'; 
            });
        });

        const goNext = () => {
            currentIndex = (currentIndex + 1) % triggers.length;
            showMedia(currentIndex);
        };

        const goPrev = () => {
            currentIndex = (currentIndex - 1 + triggers.length) % triggers.length;
            showMedia(currentIndex);
        };

        nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); goNext(); });
        prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); goPrev(); });

        const closeLightbox = () => {
            resetZoom(); 
            lightbox.classList.add('opacity-0');
            lightboxImg.classList.remove('scale-100');
            lightboxVideo.classList.remove('scale-100');
            lightboxImg.classList.add('scale-95');
            lightboxVideo.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightboxImg.src = ''; 
                lightboxVideo.src = ''; 
                document.body.style.overflow = ''; 
            }, 300); 
        };

        closeBtn?.addEventListener('click', closeLightbox);
        
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });
        
        document.addEventListener('keydown', (e) => {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') goNext();
                if (e.key === 'ArrowLeft') goPrev();
                if (e.key === '+') { currentZoom = Math.min(currentZoom + 0.5, 4); applyZoom(); }
                if (e.key === '-') { currentZoom = Math.max(currentZoom - 0.5, 0.5); applyZoom(); }
            }
        });
    }
</script>