---
import Layout from '../layouts/layout.astro';
import Navbar from '../components/Navbar.astro';
import Contacto from '../components/Contacto.astro';
import PixelCard from '../components/PixelCard.astro';
import Carrusel from '../components/Carrusel.astro';
import { obras, colecciones } from '../data/tresD';
---

<Layout>
    <Navbar />
    
    <!-- Cabecera de Diseño 3D -->
    <section class="pt-40 pb-12 px-5 text-center relative z-10">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-4">
            <span class="bg-gradient-to-r from-[#00ff66] via-[#00ccff] to-[#00ff66] bg-[length:200%_auto] text-transparent bg-clip-text animate-[gradientFlow_6s_infinite_linear]">
                Diseño 3D
            </span>
        </h1>
        <p class="text-[#cbd5e1] text-lg max-w-2xl mx-auto">
            Modelado, rigging, texturizado y optimización de assets. Flujos de trabajo orientados a la implementación técnica en motores de videojuegos.
        </p>
    </section>

    <!-- Galería 3D -->
    <section class="pb-10 px-5 relative z-10">
        <!-- Contenedor unificado para botones y galería -->
        <div class="w-full max-w-[4000px] mx-auto">
            
            <!-- Botones de Filtro (Temática Verde 3D) -->
            <div id="filtros" class="flex flex-wrap justify-center gap-3 mb-12" data-activo="bg-[#00ff66] text-[#0a0508] shadow-[0_0_15px_rgba(0,255,102,0.3)]">
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#00ff66] text-[#0a0508] shadow-[0_0_15px_rgba(0,255,102,0.3)]" data-filter="Colecciones">Colecciones</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="All">Todos</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Modelado">Modelado</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Personaje">Personajes</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Animación">Animación</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Materiales">Materiales</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="Procedural">Procedural</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#00ff66]/50" data-filter="VFX">VFX</button>
            </div>

        </div>

        <!-- Vista "Colecciones" (por defecto): un carrusel por colección (src/data/tresD.ts) -->
        <div id="colecciones" class="space-y-12">
            {colecciones.map((coleccion, i) => (
                <Carrusel titulo={coleccion.titulo} obras={obras.filter(coleccion.incluye)} inverso={i % 2 === 1} />
            ))}
        </div>

        <!-- Vista "Todos" (y el resto de filtros): todas las obras en columnas. El contenedor es elástico hasta
             los 4000px y columns-[300px] crea automáticamente las columnas que quepan según el ancho/zoom -->
        <div id="galeria-todos" class="hidden w-full max-w-[4000px] mx-auto" data-galeria>
            <div class="columns-1 sm:columns-[250px] md:columns-[300px] gap-6 space-y-6">
                {obras.map((obra) => <PixelCard {...obra} />)}
            </div>
        </div>
    </section>

    <Contacto />

    <!-- ========================================= -->
    <!-- MODAL / LIGHTBOX (Soporte Imagen y Vídeo) -->
    <!-- ========================================= -->
    <div id="lightbox" class="fixed inset-0 z-[100] hidden bg-[#0a0508]/75 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        
        <!-- Controles de Zoom -->
        <div class="absolute top-6 left-6 md:top-10 md:left-10 flex gap-2 z-50 bg-[#0a0508]/80 p-1.5 rounded-xl border border-white/10 backdrop-blur-md">
            <button id="zoom-out" class="text-white hover:text-[#00ff66] w-8 h-8 flex items-center justify-center text-2xl font-bold transition-colors cursor-pointer select-none rounded hover:bg-white/10">-</button>
            <button id="zoom-reset" class="text-white/80 hover:text-white w-10 flex items-center justify-center text-sm font-medium transition-colors cursor-pointer select-none rounded hover:bg-white/10">1x</button>
            <button id="zoom-in" class="text-white hover:text-[#00ff66] w-8 h-8 flex items-center justify-center text-2xl font-bold transition-colors cursor-pointer select-none rounded hover:bg-white/10">+</button>
        </div>

        <button id="lightbox-close" class="absolute top-6 right-6 md:top-10 md:right-10 text-white/50 hover:text-[#00ff66] text-5xl font-light z-50 transition-colors cursor-pointer">&times;</button>
        
        <button id="lightbox-prev" class="absolute left-2 md:left-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-[#00ff66] z-50 transition-colors cursor-pointer select-none p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        <!-- Contenedores maximizados (Uno para IMG y otro para VIDEO) -->
        <img id="lightbox-img" src="" alt="Arte maximizado" class="hidden max-w-full max-h-[90vh] object-contain drop-shadow-[0_0_50px_rgba(0,255,102,0.15)] scale-95 transition-transform duration-150 z-40 will-change-transform" />
        
        <video id="lightbox-video" src="" autoplay loop muted playsinline class="hidden max-w-full max-h-[90vh] object-contain drop-shadow-[0_0_50px_rgba(0,255,102,0.15)] scale-95 transition-transform duration-150 z-40 will-change-transform"></video>

        <button id="lightbox-next" class="absolute right-2 md:right-10 top-1/2 -translate-y-1/2 text-white/50 hover:text-[#00ff66] z-50 transition-colors cursor-pointer select-none p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

    </div>
</Layout>

<!-- ========================================= -->
<!-- LÓGICA JAVASCRIPT PARA EL LIGHTBOX        -->
<!-- ========================================= -->
<script>
    import '../scripts/galeria';
</script>