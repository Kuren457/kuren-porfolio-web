---
import Layout from '../layouts/layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Personales from '../components/Personales.astro';
import Portfolio from '../components/Portfolio.astro';
import SobreMi from '../components/SobreMi.astro';
import Contacto from '../components/Contacto.astro';
import Mascotas from '../components/Mascotas.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Layout>
    <Navbar />
    <Hero />
	<Personales />
	<Portfolio />
	<SobreMi />
	<Contacto />
	<Mascotas />
	<Lightbox acento="#fa5c5c" acentoSuave="rgba(250,92,92,0.15)" pixelado />
</Layout>
