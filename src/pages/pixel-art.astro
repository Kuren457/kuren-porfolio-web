<!-- LÓGICA JAVASCRIPT PARA EL LIGHTBOX        -->
<!-- ========================================= -->
<script>
    // 1. OBTENEMOS TODOS LOS ELEMENTOS DEL DOM
    const triggers = Array.from(document.querySelectorAll('.lightbox-trigger'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    // --- LÓGICA DE FILTROS ---
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            // 1. Quitar el estilo activo de todos los botones
            filterBtns.forEach(b => {
                b.classList.remove('bg-[#fa5c5c]', 'text-white', 'shadow-[0_0_15px_rgba(250,92,92,0.3)]');
                b.classList.add('bg-[#0a0508]', 'border', 'border-white/20', 'text-[#cbd5e1]');
            });

            // 2. Poner el estilo activo al botón que hemos clicado
            btn.classList.remove('bg-[#0a0508]', 'border', 'border-white/20', 'text-[#cbd5e1]');
            btn.classList.add('bg-[#fa5c5c]', 'text-white', 'shadow-[0_0_15px_rgba(250,92,92,0.3)]');

            // 3. Filtrar las tarjetas
            const filterValue = btn.getAttribute('data-filter');

            galleryItems.forEach(item => {
                // Obtenemos todas las categorías de la tarjeta juntas
                const itemCategories = item.getAttribute('data-category') || '';

                // Usamos .includes() para ver si el filtro buscado está dentro del texto
                if (filterValue === 'All' || itemCategories.includes(filterValue)) {
                    item.classList.remove('hidden');
                    // Un pequeño truco para que la animación de masonry no sea brusca
                    setTimeout(() => item.style.opacity = '1', 50); 
                } else {
                    item.style.opacity = '0';
                    setTimeout(() => item.classList.add('hidden'), 300); 
                }
            });
        });
    });
    
    // Botones de zoom
    const zoomInBtn = document.getElementById('zoom-in');
    const zoomOutBtn = document.getElementById('zoom-out');
    const zoomResetBtn = document.getElementById('zoom-reset');

    // 2. VARIABLES DE ESTADO
    let currentIndex = 0;
    let currentZoom = 1; // 1 = 100% (Tamaño original)

    if (lightbox && lightboxImg && lightboxVideo) {
        
        // --- FUNCIONES DE ZOOM ---
        
        // Aplica el nivel de zoom actual a la imagen o vídeo
        const applyZoom = () => {
            lightboxImg.style.transform = `scale(${currentZoom})`;
            lightboxVideo.style.transform = `scale(${currentZoom})`;
            if (zoomResetBtn) zoomResetBtn.innerText = `${Math.round(currentZoom * 10) / 10}x`;
        };

        // Resetea el zoom al estado original al cambiar de foto o cerrar
        const resetZoom = () => {
            currentZoom = 1;
            lightboxImg.style.transform = ''; 
            lightboxVideo.style.transform = ''; 
            if (zoomResetBtn) zoomResetBtn.innerText = '1x';
            lightboxImg.classList.add('scale-100'); 
            lightboxVideo.classList.add('scale-100'); 
        };

        // Evento: Zoom con la rueda del ratón
        lightbox.addEventListener('wheel', (e) => {
            if (!lightbox.classList.contains('hidden')) {
                e.preventDefault(); // Evita que la web haga scroll por detrás
                if (e.deltaY < 0) {
                    currentZoom = Math.min(currentZoom + 0.25, 4); // Límite máximo: 4x
                } else {
                    currentZoom = Math.max(currentZoom - 0.25, 0.5); // Límite mínimo: 0.5x
                }
                applyZoom();
            }
        });

        // Eventos: Zoom con los botones de la interfaz
        zoomInBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            currentZoom = Math.min(currentZoom + 0.5, 4);
            applyZoom();
        });
        
        zoomOutBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            currentZoom = Math.max(currentZoom - 0.5, 0.5);
            applyZoom();
        });

        zoomResetBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            resetZoom();
        });

        // --- NUEVO: FUNCIONES DE ZOOM TÁCTIL (MÓVILES) ---
        let initialDistance = 0;
        let initialZoom = 1;

        lightbox.addEventListener('touchstart', (e) => {
            // Si el usuario toca la pantalla exactamente con dos dedos
            if (e.touches.length === 2 && !lightbox.classList.contains('hidden')) {
                // Calculamos la distancia inicial entre los dedos (hipotenusa)
                initialDistance = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
                initialZoom = currentZoom;
            }
        });

        lightbox.addEventListener('touchmove', (e) => {
            // Mientras los dedos se mueven por la pantalla
            if (e.touches.length === 2 && !lightbox.classList.contains('hidden')) {
                e.preventDefault(); // Bloquea el zoom nativo del navegador móvil
                
                // Calculamos la nueva distancia
                const currentDistance = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
                
                // Aplicamos la proporción (si se alejan aumenta, si se juntan disminuye)
                const zoomFactor = currentDistance / initialDistance;
                currentZoom = Math.min(Math.max(initialZoom * zoomFactor, 0.5), 4);
                applyZoom();
            }
        }, { passive: false }); // Permite que funcione el preventDefault() en touchmove


        // --- FUNCIONES DE GALERÍA Y MULTIMEDIA ---
        
        // Carga el archivo y decide si debe usar <img> o <video>
        const showMedia = (index) => {
            const src = triggers[index].getAttribute('data-src');
            if (src) {
                resetZoom(); 
                
                const isVideo = src.endsWith('.webm') || src.endsWith('.mp4');
                
                if (isVideo) {
                    lightboxImg.classList.add('hidden');
                    lightboxImg.src = '';
                    
                    lightboxVideo.src = src;
                    lightboxVideo.classList.remove('hidden');
                    lightboxVideo.play();
                } else {
                    lightboxVideo.classList.add('hidden');
                    lightboxVideo.pause();
                    lightboxVideo.src = '';
                    
                    lightboxImg.src = src;
                    lightboxImg.classList.remove('hidden');
                }
            }
        };

        // Evento: Abrir el modal al hacer click en una tarjeta
        triggers.forEach((trigger, index) => {
            trigger.addEventListener('click', () => {
                currentIndex = index;
                showMedia(currentIndex);
                
                lightbox.classList.remove('hidden');
                setTimeout(() => {
                    lightbox.classList.remove('opacity-0');
                    lightboxImg.classList.remove('scale-95');
                    lightboxVideo.classList.remove('scale-95');
                    lightboxImg.classList.add('scale-100');
                    lightboxVideo.classList.add('scale-100');
                }, 10);
                
                document.body.style.overflow = 'hidden'; // Evita scroll en la página de fondo
            });
        });

        // Controles Anterior / Siguiente
        const goNext = () => {
            currentIndex = (currentIndex + 1) % triggers.length;
            showMedia(currentIndex);
        };

        const goPrev = () => {
            currentIndex = (currentIndex - 1 + triggers.length) % triggers.length;
            showMedia(currentIndex);
        };

        nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); goNext(); });
        prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); goPrev(); });

        // Evento: Cerrar el modal
        const closeLightbox = () => {
            resetZoom(); 
            lightbox.classList.add('opacity-0');
            lightboxImg.classList.remove('scale-100');
            lightboxVideo.classList.remove('scale-100');
            lightboxImg.classList.add('scale-95');
            lightboxVideo.classList.add('scale-95');
            
            // Retraso para dejar que la transición visual termine
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightboxImg.src = ''; 
                lightboxVideo.src = ''; 
                document.body.style.overflow = ''; // Devuelve el scroll a la página
            }, 300); 
        };

        // Cerrar al hacer click en la X o en el fondo oscuro
        closeBtn?.addEventListener('click', closeLightbox);
        
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });
        
        // Atajos de Teclado
        document.addEventListener('keydown', (e) => {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') goNext();
                if (e.key === 'ArrowLeft') goPrev();
                if (e.key === '+') { currentZoom = Math.min(currentZoom + 0.5, 4); applyZoom(); }
                if (e.key === '-') { currentZoom = Math.max(currentZoom - 0.5, 0.5); applyZoom(); }
            }
        });
    }
</script>