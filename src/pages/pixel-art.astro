---
import Layout from '../layouts/layout.astro';
import Navbar from '../components/Navbar.astro';
import Contacto from '../components/Contacto.astro';
import PixelCard from '../components/PixelCard.astro';
---

<Layout>
    <Navbar />
    
    <!-- Cabecera de Pixel Art -->
    <section class="pt-40 pb-12 px-5 text-center relative z-10">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-4">
            <span class="bg-gradient-to-r from-[#fa5c5c] via-[#ffaa00] to-[#fa5c5c] bg-[length:200%_auto] text-transparent bg-clip-text animate-[gradientFlow_6s_infinite_linear]">
                Pixel Art
            </span>
        </h1>
        <p class="text-[#cbd5e1] text-lg max-w-2xl mx-auto">
            Diseño de personajes, escenarios y animaciones creadas en Aseprite.
        </p>
    </section>

    <!-- Galería de Pixel Art -->
    <section class="pb-10 px-5 relative z-10">

        <div class="container mx-auto max-w-6xl">
            
            <!-- NUEVO: Botones de Filtro -->
            <div class="flex flex-wrap justify-center gap-3 mb-12">
                <!-- El botón "Todos" empieza activo (con el fondo rojo) -->
                <button class="filter-btn active-filter px-6 py-2 rounded-full font-bold transition-all bg-[#fa5c5c] text-white shadow-[0_0_15px_rgba(250,92,92,0.3)]" data-filter="All">Todos</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Personaje">Personajes</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Animacion">Animación</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Escenario">Escenarios</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="VFX">VFX</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Marvel Rivals">Marvel Rivals</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="BloodRunner">BloodRunner</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Jams">Jams</button>
                <button class="filter-btn px-6 py-2 rounded-full font-bold transition-all bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c]/50" data-filter="Valorant">Valorant</button>
