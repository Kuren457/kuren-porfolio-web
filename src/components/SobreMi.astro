---
// src/components/SobreMi.astro
import { marcoAleatorio } from '../utils/marcoAleatorio';
---
<section id="sobre-mi" class="py-24 px-5 relative z-10">
    <div class="container mx-auto max-w-5xl">
        <!-- Título de Sección -->
        <h2 class="text-3xl md:text-5xl font-bold mb-12 text-center">
            <span class="bg-gradient-to-r from-[#ff3333] to-[#ffaa00] text-transparent bg-clip-text">
                Sobre Mí
            </span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <!-- Columna de Texto -->
            <div data-aparicion class={`${marcoAleatorio()} space-y-6 text-[#cbd5e1] text-lg leading-relaxed bg-[#1a050a]/40 p-8 backdrop-blur-md shadow-[0_0_30px_rgba(255,170,0,0.05)]`}>
                <p>
                    Soy artista digital y estudiante universitario de desarrollo de videojuegos, especializado en abarcar todo el espectro visual de un proyecto interactivo.
                </p>
                <p>
                    Mi enfoque principal está en el <strong>rigging, la animación 3D y el pixel art</strong>. Me apasiona diseñar no solo los personajes y entornos, sino también crear interfaces de usuario (UI) dinámicas y coherentes que mejoren la experiencia del jugador.
                </p>
                <p>
                    Estoy acostumbrado a trabajar estrechamente en equipo, formando tándem con perfiles técnicos de programación. Mi objetivo es asegurar que cada asset visual, desde un sprite sheet hasta un modelo 3D complejo, se integre de manera fluida y optimizada en el motor del juego.
                </p>
            </div>

            <!-- Columna de Herramientas -->
            <div class="grid grid-cols-2 gap-4">
                <!-- Tarjeta Unreal Engine -->
                <div data-aparicion class={`${marcoAleatorio()} bg-[#0a0508]/80 p-6 flex flex-col items-center text-center transition-shadow hover:shadow-[0_0_20px_rgba(255,170,0,0.15)] cursor-default`}>
                    <img src="/Pixel-art/UI Elements/LogoUE.png" data-intro="/Pixel-art/UI Elements/LogoUE_intro.gif" alt="Logo Unreal Engine" style="image-rendering: pixelated;" class="w-16 h-16 mb-4" />
                    <h3 class="text-white font-bold mb-2">Unreal Engine</h3>
                    <p class="text-sm text-[#94a3b8]">Blueprints, Materiales, Level Sequences</p>
                </div>

                <!-- Tarjeta Blender -->
                <div data-aparicion class={`${marcoAleatorio()} bg-[#0a0508]/80 p-6 flex flex-col items-center text-center transition-shadow hover:shadow-[0_0_20px_rgba(255,170,0,0.15)] cursor-default`}>
                    <img src="/Pixel-art/UI Elements/LogoBlender.png" data-intro="/Pixel-art/UI Elements/LogoBlender_intro.gif" alt="Logo Blender" style="image-rendering: pixelated;" class="w-16 h-16 mb-4" />
                    <h3 class="text-white font-bold mb-2">Blender</h3>
                    <p class="text-sm text-[#94a3b8]">Modelado 3D, Rigging, Animación</p>
                </div>

                <!-- Tarjeta Aseprite (ocupa las 2 columnas para cerrar la rejilla) -->
                <div data-aparicion class={`col-span-2 ${marcoAleatorio()} bg-[#0a0508]/80 p-6 flex flex-col items-center text-center transition-shadow hover:shadow-[0_0_20px_rgba(255,170,0,0.15)] cursor-default`}>
                    <img src="/Pixel-art/UI Elements/LogoAseprite.png" data-intro="/Pixel-art/UI Elements/LogoAseprite_intro.gif" alt="Logo Aseprite" style="image-rendering: pixelated;" class="w-16 h-16 mb-4" />
                    <h3 class="text-white font-bold mb-2">Aseprite</h3>
                    <p class="text-sm text-[#94a3b8]">Pixel Art, UI, Sprite Sheets</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Las tarjetas con data-aparicion aparecen con un pop al entrar en pantalla (y los logos con data-intro se animan) -->
<script>
    import '../scripts/aparicion';
</script>