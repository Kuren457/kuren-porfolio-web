---
// src/components/Hero.astro
import { marcoAleatorio } from '../utils/marcoAleatorio';
---
<!-- Inicio / Cabecera (compacta: justo debajo van los trabajos personales y los proyectos) -->
<section id="inicio" class="flex flex-col items-center justify-center text-center px-5 relative z-10 pt-28 pb-10">
    
    <!-- Avatar (Corregido el rounded-xl) -->
    <img src="/png-banners/avatar.png" alt="Miguel Ángel Vera Ximénez" class="rounded-xl object-cover mb-6 shadow-lg shadow-orange-500/20 w-24 h-24 md:w-32 md:h-32" />

    <!-- Título -->
    <h1 class="font-extrabold mb-3 text-3xl md:text-5xl leading-tight text-white">
        Miguel Ángel Vera Ximénez
    </h1>

    <!-- Subtítulo -->
    <h2 class="font-bold text-white mb-4 text-xl md:text-2xl">
        Digital Artist & Game Developer
    </h2>

    <!-- Párrafo -->
    <p class="text-[#cbd5e1] mx-auto text-base max-w-2xl">
        Hago arte para videojuegos, en pixel art y en 3D, y he trabajado en BloodRunner, OuroJam, Hells Gamble y Neorb.
    </p>

    <!-- Botones de Acción -->
    <div class="flex flex-wrap justify-center gap-4 mt-6 relative z-20">
        
        <a href="#sobre-mi" class={`marco-boton ${marcoAleatorio()} px-8 py-3 text-base md:text-lg bg-gradient-to-r from-[#ff3333] to-[#ffaa00] text-white font-bold hover:scale-105 transition-transform shadow-lg shadow-orange-500/20`}>
            Conóceme
        </a>

        <a href="#portfolio" class={`marco-boton ${marcoAleatorio()} px-8 py-3 text-base md:text-lg bg-[#0a0508] text-white font-bold hover:bg-white/10 hover:scale-105 transition-all`}>
            Mi Portfolio
        </a>

        <a href="/pixel-art" class={`marco-boton ${marcoAleatorio()} px-8 py-3 text-base md:text-lg bg-[#0a0508] text-[#fa5c5c] font-bold hover:bg-[#fa5c5c]/10 hover:scale-105 hover:shadow-[0_0_15px_rgba(250,92,92,0.3)] transition-all flex items-center gap-2`}>
            Pixel Art
        </a>

        <a href="/3d" class={`marco-boton ${marcoAleatorio()} px-8 py-3 text-base md:text-lg bg-[#0a0508] text-[#00ff66] font-bold hover:bg-[#00ff66]/10 hover:scale-105 hover:shadow-[0_0_15px_rgba(0,255,102,0.3)] transition-all flex items-center gap-2`}>
            Diseño 3D
        </a>
    </div>
</section>