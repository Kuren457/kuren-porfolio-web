---
// src/components/Portfolio.astro
// Proyectos de la página principal: una fila por proyecto con su tarjeta (enlace a itch.io), nombre,
// descripción y un mini carrusel con sus obras. Los datos están en src/data/proyectos.ts.
// La tarjeta lleva un marco vegetal al azar o, si el proyecto tiene uno propio (marco), ese GIF por encima;
// con persecucion, además, el demonio y la galleta corren a su alrededor.
import Carrusel from './Carrusel.astro';
import Persecucion from './Persecucion.astro';
import { proyectos } from '../data/proyectos';
import { marcoAleatorio } from '../utils/marcoAleatorio';
---
<section id="portfolio" class="py-16 px-5 relative z-10">
    <div class="container mx-auto max-w-6xl">
        <!-- Título de Sección -->
        <h2 class="text-3xl md:text-5xl font-bold mb-12 text-center">
            <span class="bg-gradient-to-r from-[#ff3333] to-[#ffaa00] text-transparent bg-clip-text">
                Proyectos
            </span>
        </h2>

        <!-- Separación de 64 px: el sitio por el que corre la persecución -->
        <div class="space-y-16">
            {proyectos.map((proyecto, i) => (
                <article class="proyecto">
                    <div class="proyecto__lugar">
                        <!-- Tarjeta con el logo: enlace a itch.io -->
                        <a href={proyecto.enlace} target="_blank" rel="noopener noreferrer" data-aparicion data-sitio-mascota
                            class:list={['proyecto__tarjeta group flex items-center justify-center',
                                proyecto.marco ? 'proyecto__tarjeta--marco' : `${marcoAleatorio()} bg-[#0a0508]`]}
                            aria-label={`${proyecto.nombre} en itch.io`}>
                            {proyecto.marco && <div class="proyecto__fondo"></div>}
                            <img src={proyecto.logo} alt=""
                                style={[proyecto.logoPixelado && 'image-rendering: pixelated;', proyecto.logoAncho && `width: ${proyecto.logoAncho}px;`].filter(Boolean).join(' ') || undefined}
                                class="proyecto__logo w-3/5 h-auto drop-shadow-md group-hover:scale-110 transition-transform duration-300" />
                            <span class="proyecto__aviso absolute bottom-4 inset-x-0 text-center text-xs text-[#cbd5e1] opacity-0 group-hover:opacity-100 transition-opacity">Ver en itch.io ↗</span>
                            {proyecto.marco && <img class="proyecto__marco" src={proyecto.marco} alt="" />}
                        </a>
                        {proyecto.persecucion && <Persecucion />}
                    </div>

                    <!-- Nombre y descripción -->
                    <div class="proyecto__texto">
                        <h3 class="text-2xl text-white mb-2">{proyecto.nombre}</h3>
                        <span class="inline-block px-3 py-1 mb-3 text-xs text-[#ffaa00] bg-[#ffaa00]/10 rounded-full border border-[#ffaa00]/20">{proyecto.herramientas}</span>
                        <p class="text-[#cbd5e1] text-sm">{proyecto.descripcion}</p>
                    </div>

                    <!-- Mini carrusel con sus obras -->
                    <Carrusel etiqueta={`Obras de ${proyecto.nombre}`} obras={proyecto.obras} inverso={i % 2 === 1} mini />
                </article>
            ))}
        </div>
    </div>
</section>

<!-- Las tarjetas con data-aparicion aparecen con un pop al entrar en pantalla -->
<script>
    import '../scripts/aparicion';
</script>
