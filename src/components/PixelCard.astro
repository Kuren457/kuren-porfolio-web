---
// src/components/PixelCard.astro
// Tarjeta de la galería envuelta en el marco pixel art (9-slice, ver .pixel-card en global.css)
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { imageMetadata } from 'astro/assets/utils';
import { idiomaDe } from '../i18n/idioma';
import { textos } from '../i18n/textos';
import { etiquetas, traducir } from '../i18n/obras';
import { animacionesDe, type Hoja } from '../utils/hojas';

const UI = '/Pixel-art/UI Elements/';
const ANCHO_TIMELAPSE = 288; // Ancho máximo en px de las tarjetas de timelapse (se ajusta a una escala entera)

// Cada tema elige el logo de la pestaña (y su animación de aparición) y el color del marco
// (los archivos de color y las animaciones *_intro.gif se generan con `npm run marcos`)
const TEMAS = {
    marvel:      { logo: 'LogoMR.png',          intro: 'LogoMR_intro.gif',       logoAlt: 'Logo Marvel Rivals', marco: 'amarillo' },
    valorant:    { logo: 'LogoValo.png',        intro: 'LogoValo_intro.gif',     logoAlt: 'Logo Valorant',      marco: 'rojo' },
    memes:       { logo: 'LogoMemes.png',       intro: 'LogoMemes_intro.gif',    logoAlt: 'Logo Memes',         marco: 'gris' },
    og:          { logo: 'LogoOG.png',          intro: 'LogoOG_intro.gif',       logoAlt: 'Logo OG',            marco: 'verde' },
    tutorial:    { logo: 'LogoOG.png',          intro: 'LogoOG_intro.gif',       logoAlt: 'Logo OG',            marco: 'verde' },
    bloodrunner: { logo: 'LogoBloodRunner.png', intro: 'LogoBR_intro.gif',       logoAlt: 'Logo BloodRunner',   marco: 'rojoOscuro' },
    ourojam:     { logo: 'LogoOurojam.png',     intro: 'LogoOurojam_intro.gif',  logoAlt: 'Logo Ourojam',       marco: 'azul' },
    gambling:    { logo: 'LogoGambling.png',    intro: 'LogoGambling_intro.gif', logoAlt: 'Logo Gambling',      marco: 'azul' },
    blender:     { logo: 'LogoBlender.png',     intro: 'LogoBlender_intro.gif',  logoAlt: 'Logo Blender',       marco: 'naranja', render: true },
    unreal:      { logo: 'LogoUE.png',          intro: 'LogoUE_intro.gif',       logoAlt: 'Logo Unreal Engine', marco: 'azul',    render: true },
};

export interface Props {
    src: string;
    ampliada?: string;          // Lo que abre el visor en vez de src (p. ej. la captura de unos nodos a resolución real)
    alt?: string;
    category: string;
    title: string;
    description: string;
    tema?: keyof typeof TEMAS;  // Sin tema: marco gris y sin logo
    logo?: string;              // Sustituye el logo del tema
    logoAlt?: string;
    ancho?: number;             // Solo vídeos: ancho y alto en píxeles (en las imágenes se leen solos)
    alto?: number;
    hoja?: Hoja;                // src es una hoja de sprites: la tarjeta reproduce sus animaciones y el visor enseña la hoja
    timelapse?: string;         // GIF a 1x de cómo se dibujó src (timelapses.ts). Sección de timelapses: se enseña la obra
                                // y se desvanece a él; en un carrusel: crece y se reproduce al mantener el ratón encima
    variante?: 'galeria' | 'carrusel'; // galeria: columnas de "Todos"; carrusel: altura fija y ancho natural
    copia?: boolean;            // Segunda tanda de un carrusel, solo para que el bucle no tenga corte
}

const { src, ampliada, alt = '', category, tema, hoja, timelapse, variante = 'galeria', copia = false } = Astro.props;
// Los textos de las obras se escriben en español; en la versión en inglés se traducen (src/i18n/obras.ts)
const idioma = idiomaDe(Astro);
const controles = textos(idioma).hojas;
// Iconos de los controles de las hojas de sprites: 16x16, hechos de píxeles
const icono = (contenido: string) => `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges">${contenido}</svg>`;
const ICONOS = {
    anterior: icono('<rect x="3" y="3" width="2" height="10"/><path d="M13 3v10L6 8z"/>'),
    siguiente: icono('<rect x="11" y="3" width="2" height="10"/><path d="M3 3v10l7-5z"/>'),
    pausa: icono('<rect class="hoja__icono-pausa" x="4" y="3" width="3" height="10"/><rect class="hoja__icono-pausa" x="9" y="3" width="3" height="10"/><path class="hoja__icono-reproducir" d="M4 2v12l9-6z"/>'),
    cebolla: icono('<rect x="1" y="4" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"/><rect x="6" y="2" width="9" height="9"/>'),
    animacionAnterior: icono('<path d="M8 3v10L2 8z"/><path d="M14 3v10L8 8z"/>'),
    animacionSiguiente: icono('<path d="M2 3v10l6-5z"/><path d="M8 3v10l6-5z"/>'),
};
const title = traducir(Astro.props.title, idioma);
const description = traducir(Astro.props.description, idioma);
const temaActual: { logo?: string; intro?: string; logoAlt: string; marco: string; render?: boolean } | undefined = tema ? TEMAS[tema] : undefined;
const logo = Astro.props.logo ?? (temaActual?.logo && UI + temaActual.logo);
// Un logo sustituido a mano no tiene animación de aparición
const logoIntro = Astro.props.logo ? undefined : temaActual?.intro && UI + temaActual.intro;
const logoAlt = Astro.props.logoAlt ?? temaActual?.logoAlt ?? '';
const marco = `${UI}MarcoUniversal_1x_${temaActual?.marco ?? 'gris'}.png`;
const marcoIntro = `${UI}MarcoUniversal_intro_${temaActual?.marco ?? 'gris'}.gif`;

const esVideo = /\.(webm|mp4)$/i.test(src);

// Ancho y alto reales de la imagen (se leen al generar la página): así el navegador reserva su hueco antes
// de descargarla y la galería no se recoloca al cargar, que es lo que necesita la aparición al entrar en pantalla
// (los vídeos no se pueden leer así: sus medidas vienen en los datos)
// (en las hojas de sprites, lo que se ve es un fotograma)
const animaciones = hoja && await animacionesDe(src, hoja);
const { width, height } = esVideo
    ? { width: Astro.props.ancho, height: Astro.props.alto }
    : animaciones ? { width: animaciones.ancho, height: animaciones.alto }
    : await imageMetadata(await readFile(join(process.cwd(), 'public', src)), src);

// Los renders 3D y los vídeos (grabados a 1080p, se ven reducidos) se escalan suavizados; el pixel art, sin suavizar
const estiloMedia = temaActual?.render || esVideo ? undefined : 'image-rendering: pixelated;';
const claseMedia = 'pixel-card__media w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500';
const timelapseAlPasar = !!timelapse && variante === 'carrusel';
const claseVariante = variante === 'carrusel' ? `pixel-card--carrusel${timelapseAlPasar ? ' pixel-card--timelapse-al-pasar' : ''}`
    : timelapse ? 'pixel-card--timelapse' : 'gallery-item break-inside-avoid';

// Sección de timelapses: a una escala entera de su tamaño a 1x para que los píxeles salgan iguales
const anchoTimelapse = timelapse && !timelapseAlPasar
    && (await imageMetadata(await readFile(join(process.cwd(), 'public', timelapse)), timelapse)).width;
const anchoMostrado = anchoTimelapse && anchoTimelapse * Math.floor(ANCHO_TIMELAPSE / anchoTimelapse);
// Al pasar el ratón ya crece toda la tarjeta: la imagen no se amplía dentro
const claseZoom = timelapseAlPasar ? '' : 'group-hover:scale-105';
---

<div class={`${claseVariante} lightbox-trigger pixel-card group cursor-pointer transition-opacity duration-300`} data-src={ampliada ?? src} data-category={category} data-etiquetas={etiquetas(category, idioma)} data-title={title} data-description={description} data-copia={copia || undefined} aria-hidden={copia ? 'true' : undefined} style={`--marco: url('${marco}');`}>
    <!-- data-aparicion: aparece con un pop al entrar en pantalla y arranca las animaciones del marco y el logo (src/scripts/aparicion.ts) -->
    <div class="pixel-card__frame" data-aparicion data-intro-marco={marcoIntro}>

        <!-- Contenido central -->
        <div class="relative overflow-hidden bg-[#0a0508]">
            {timelapse ? (
                <div class="timelapse" data-timelapse={timelapse} data-al-pasar={timelapseAlPasar || undefined}
                    style={anchoMostrado ? `width: ${anchoMostrado}px;` : undefined}>
                    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" style={estiloMedia} class={claseMedia.replace('group-hover:scale-105', claseZoom)} />
                    <img alt="" style={estiloMedia} class={`timelapse__proceso ${claseZoom}`} />
                    <div class="timelapse__progreso"></div>
                    <!-- Sale mientras se mantiene pulsado para acelerarlo (timelapses.ts) -->
                    <div class="timelapse__rapido" aria-hidden="true">×5</div>
                </div>
            ) : animaciones
                ? <canvas data-hoja={JSON.stringify(animaciones)} data-src={src} width={width} height={height} role="img" aria-label={alt || title} style={estiloMedia} class={`${claseMedia} pixel-card__hoja`}></canvas>
            : esVideo
                ? <video data-video={src} width={width} height={height} loop muted playsinline preload="none" style={estiloMedia} class={claseMedia}></video>
                : <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" style={estiloMedia} class={claseMedia} />}
            <!-- Al pasar el ratón, solo el nombre (la descripción sale en la ficha del visor, Lightbox.astro) -->
            {!timelapseAlPasar && <div class="absolute inset-0 bg-gradient-to-t from-[#0a0508]/90 via-[#0a0508]/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4 pointer-events-none">
                <h3 class="text-lg font-bold text-white leading-tight">{title}</h3>
            </div>}
        </div>

        <!-- Logo en el hueco de la pestaña -->
        <!-- Hojas de sprites: controles de la animación (src/scripts/hojas.ts) -->
        {animaciones && (
            <div class="hoja__controles" data-controles>
                {animaciones.animaciones.length > 1 && (
                    <div class="hoja__grupo">
                        <button type="button" data-accion="animacion-anterior" aria-label={controles.animacionAnterior} title={controles.animacionAnterior} set:html={ICONOS.animacionAnterior} />
                        <span data-animacion title={controles.animacion}>1/{animaciones.animaciones.length}</span>
                        <button type="button" data-accion="animacion-siguiente" aria-label={controles.animacionSiguiente} title={controles.animacionSiguiente} set:html={ICONOS.animacionSiguiente} />
                    </div>
                )}
                <div class="hoja__grupo">
                    <button type="button" data-accion="anterior" aria-label={controles.anterior} title={controles.anterior} set:html={ICONOS.anterior} />
                    <button type="button" data-accion="pausa" data-reproduciendo="true" data-pausar={controles.pausar} data-reproducir={controles.reproducir} aria-label={controles.pausar} title={controles.pausar} set:html={ICONOS.pausa} />
                    <button type="button" data-accion="siguiente" aria-label={controles.siguiente} title={controles.siguiente} set:html={ICONOS.siguiente} />
                    <span data-contador title={controles.fotograma}>1/{animaciones.animaciones[0].fotogramas.length}</span>
                </div>
                <div class="hoja__grupo">
                    <button type="button" data-accion="velocidad" aria-label={controles.velocidad} title={controles.velocidad} class="hoja__velocidad">1×</button>
                    <button type="button" data-accion="cebolla" aria-pressed="false" aria-label={controles.cebolla} title={controles.cebolla} set:html={ICONOS.cebolla} />
                </div>
            </div>
        )}

        {logo && <img src={logo} alt={logoAlt} data-intro={logoIntro} class="pixel-card__logo" />}
    </div>
</div>

<script>
    import '../scripts/aparicion';
    import '../scripts/videos';
    import '../scripts/hojas';
    import '../scripts/timelapses';
</script>
