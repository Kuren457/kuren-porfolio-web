---
// src/components/ArteTecnico.astro
// Sección de la portada que presenta el 3D y los breakdowns de materiales: una tarjeta por breakdown (su primer vídeo
// del resultado, en bucle, y un enlace a él) y botones a la galería 3D y a todos los breakdowns.
import { arcane, comic, crystal, postProceso, type Breakdown } from '../data/materiales';
import { marcoAleatorio } from '../utils/marcoAleatorio';
import { idiomaDe, rutas } from '../i18n/idioma';
import { textos } from '../i18n/textos';

const idioma = idiomaDe(Astro);
const t = textos(idioma).arteTecnico;
const r = rutas(idioma);

const tarjetas: { breakdown: Breakdown; enlace: string; resumen: string }[] = [
    { breakdown: postProceso, enlace: `${r.proyecto('neorb')}#breakdown-post-proceso`, resumen: t.postProceso },
    { breakdown: comic, enlace: `${r.tresD}#breakdown-comic`, resumen: t.comic },
    { breakdown: arcane, enlace: `${r.tresD}#breakdown-arcane`, resumen: t.arcane },
    { breakdown: crystal, enlace: `${r.tresD}#breakdown-crystal`, resumen: t.crystal },
];
---

<section id="arte-tecnico" class="py-16 px-5 relative z-10">
    <div class="container mx-auto max-w-6xl text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
            <span class="bg-gradient-to-r from-[#00ff66] to-[#00ccff] text-transparent bg-clip-text">{t.titulo}</span>
        </h2>
        <p class="text-[#cbd5e1] max-w-2xl mx-auto">{t.texto}</p>

        <div class="arte-tecnico__tarjetas">
            {tarjetas.map(({ breakdown, enlace, resumen }) => {
                const video = breakdown.portada.find((figura) => /\.(webm|mp4)$/i.test(figura.src))!;
                return (
                    <a href={enlace} data-aparicion class={`arte-tecnico__tarjeta group ${marcoAleatorio({ conTexto: true })}`}>
                        <div class="arte-tecnico__video">
                            <video data-video={video.src} width={video.ancho} height={video.alto} loop muted playsinline preload="none" aria-hidden="true"></video>
                        </div>
                        <h3 class="text-lg font-bold text-white mt-4">{breakdown.titulo[idioma]}</h3>
                        <p class="text-sm text-[#94a3b8] mt-1">{resumen}</p>
                        <span class="inline-block text-sm text-[#00ff66] font-bold mt-3 group-hover:underline">{t.verBreakdown}</span>
                    </a>
                );
            })}
        </div>

        <div class="flex flex-wrap justify-center gap-4 mt-10">
            <a href={r.tresD} class={`marco-boton ${marcoAleatorio()} px-8 py-3 bg-[#0a0508] text-[#00ff66] font-bold hover:bg-[#00ff66]/10 hover:scale-105 transition-all`}>{t.galeria}</a>
            <a href={`${r.tresD}#breakdowns`} class={`marco-boton ${marcoAleatorio()} px-8 py-3 bg-[#0a0508] text-[#00ccff] font-bold hover:bg-[#00ccff]/10 hover:scale-105 transition-all`}>{t.breakdowns}</a>
        </div>
    </div>
</section>

<script>
    import '../scripts/aparicion';
    import '../scripts/videos';
</script>
