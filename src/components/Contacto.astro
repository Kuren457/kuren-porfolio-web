---
// src/components/Contacto.astro
---
<section id="contacto" class="py-20 px-5 relative z-10 border-t border-white/5 bg-[#0a0508]/80 mt-12">
    <div class="container mx-auto max-w-4xl text-center">
        <!-- Título -->
        <h2 class="text-3xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-[#ff3333] to-[#ffaa00] text-transparent bg-clip-text">
                ¿Quieres contactar conmigo?
            </span>
        </h2>
        
        <!-- Breve texto -->
        <p class="text-[#cbd5e1] mb-10 text-lg max-w-2xl mx-auto">
            Siempre estoy abierto a colaborar en nuevos proyectos, participar en jams o simplemente charlar sobre desarrollo de videojuegos y arte digital.
        </p>

        <!-- Botones de Contacto -->
        <div class="flex flex-wrap justify-center items-center gap-4 mb-16">
            <!-- Botón de Email Principal -->
            <a href="mailto:miguelangel2veraximenez@gmail.com" class="px-8 py-4 rounded-full font-bold bg-gradient-to-r from-[#cc0000] to-[#ffaa00] text-white shadow-[0_5px_15px_rgba(255,170,0,0.2)] hover:-translate-y-1 hover:shadow-[0_8px_25px_rgba(255,170,0,0.4)] transition-all duration-300 w-full sm:w-auto">
                ✉️ Enviar un Mensaje
            </a>
            
            <!-- Botón Itch.io -->
            <a href="https://kurenm.itch.io" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-full font-bold bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#fa5c5c] hover:text-[#fa5c5c] hover:shadow-[0_0_15px_rgba(250,92,92,0.3)] hover:-translate-y-1 transition-all duration-300 flex items-center gap-2">
                👾 Itch.io
            </a>

            <!-- Botón LinkedIn -->
            <a href="https://www.linkedin.com/in/kuren-dev-art" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-full font-bold bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#0a66c2] hover:text-[#0a66c2] hover:shadow-[0_0_15px_rgba(10,102,194,0.3)] hover:-translate-y-1 transition-all duration-300 flex items-center gap-2">
                💼 LinkedIn
            </a>

            <!-- Botón Instagram -->
            <a href="https://www.instagram.com/kumori.457" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-full font-bold bg-[#0a0508] border border-white/20 text-[#cbd5e1] hover:border-[#e1306c] hover:text-[#e1306c] hover:shadow-[0_0_15px_rgba(225,48,108,0.3)] hover:-translate-y-1 transition-all duration-300 flex items-center gap-2">
                📸 Instagram
            </a>
        </div>

        <!-- Mini Footer integrado -->
        <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-[#94a3b8]">
            <p>&copy; {new Date().getFullYear()} Miguel Ángel Vera Ximénez.</p>
            <p>Desarrollado con Astro & TailwindCSS</p>
        </div>
    </div>
</section>