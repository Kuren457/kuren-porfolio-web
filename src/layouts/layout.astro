---
import { Font } from 'astro:assets';
import BotonAnimaciones from '../components/BotonAnimaciones.astro';
import '../styles/global.css';
import { equivalente, idiomaDe } from '../i18n/idioma';
import { textos } from '../i18n/textos';

interface Props {
    titulo?: string;      // Título de la pestaña (y de la vista previa al compartir el enlace)
    descripcion?: string; // Para los buscadores y la vista previa
}

const idioma = idiomaDe(Astro);
const t = textos(idioma);
const { titulo = t.sitio.titulo, descripcion = t.sitio.descripcion } = Astro.props;
// Vista previa al compartir un enlace (Open Graph: LinkedIn, Discord, WhatsApp...). La imagen se genera con npm run og
const url = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(`/og/og-${idioma}.png`, Astro.site);
// La misma página en cada idioma, para los buscadores
const alternativas = (['es', 'en'] as const).map((otro) => ({ idioma: otro, url: new URL(equivalente(Astro.url.pathname, otro), Astro.site) }));
---

<!doctype html>
<html lang={idioma}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/png-banners/avatar.png" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={url} />
		{alternativas.map((a) => <link rel="alternate" hreflang={a.idioma} href={a.url} />)}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t.sitio.titulo} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={imagen} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.sitio.imagenAlt} />
		<meta property="og:locale" content={idioma === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:locale:alternate" content={idioma === 'es' ? 'en_US' : 'es_ES'} />
		<meta name="twitter:card" content="summary_large_image" />
        
        <!-- Fuente pixel art (configurada en astro.config.mjs) -->
        <Font cssVariable="--font-tiny5" preload={[{ style: 'normal' }]} />

        <!-- Elige la aparición de las tarjetas (src/scripts/aparicion.ts): completa (pop + marco + logo) o suave
             (solo el logo). Manda lo elegido con BotonAnimaciones; si no se ha elegido, el ajuste "reducir movimiento".
             Va en línea en el <head> para que las tarjetas no lleguen a verse antes de ocultarse -->
        <script is:inline>
            let modo;
            try {
                modo = localStorage.getItem('modoAnimaciones');
            } catch {}
            if (modo !== 'completo' && modo !== 'suave') {
                modo = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'suave' : 'completo';
            }
            document.documentElement.classList.add(modo === 'completo' ? 'intro-activa' : 'intro-suave');
        </script>
	</head>
	<body class="antialiased">
		<slot />
		<BotonAnimaciones />
	</body>
</html>